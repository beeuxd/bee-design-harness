{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "FrontierOS Design System tokens — single source of truth. CSS variables are generated output.",

  "primitive": {
    "color": {
      "purple-500": { "$type": "color", "$value": "#9d7bf1" },
      "purple-600": { "$type": "color", "$value": "#764ae2" },
      "purple-accent": { "$type": "color", "$value": "#a29bfd" },
      "prism": { "$type": "color", "$value": "#B6B1F6" },
      "red-400": { "$type": "color", "$value": "#f87171" },
      "red-50": { "$type": "color", "$value": "#fef2f2" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#000000" },
      "zinc-900": { "$type": "color", "$value": "#18181b" },
      "neutral-900": { "$type": "color", "$value": "#0a0a0a" },
      "neutral-800": { "$type": "color", "$value": "#262626" },
      "neutral-500": { "$type": "color", "$value": "#737373" },
      "neutral-200": { "$type": "color", "$value": "#e5e5e5" },
      "neutral-100": { "$type": "color", "$value": "#f5f5f5" },
      "neutral-50": { "$type": "color", "$value": "#fafafa" },
      "transparent": { "$type": "color", "$value": "#ffffff00" }
    },
    "spacing": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "32": { "$type": "dimension", "$value": "128px" }
    },
    "fontSize": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" },
      "4xl": { "$type": "dimension", "$value": "36px" },
      "5xl": { "$type": "dimension", "$value": "48px" }
    },
    "lineHeight": {
      "xs": { "$type": "dimension", "$value": "16px" },
      "sm": { "$type": "dimension", "$value": "20px" },
      "base": { "$type": "dimension", "$value": "24px" },
      "lg": { "$type": "dimension", "$value": "28px" },
      "xl": { "$type": "dimension", "$value": "28px" },
      "2xl": { "$type": "dimension", "$value": "32px" },
      "3xl": { "$type": "dimension", "$value": "36px" },
      "4xl": { "$type": "dimension", "$value": "40px" },
      "5xl": { "$type": "dimension", "$value": "48px" }
    },
    "fontWeight": {
      "light": { "$type": "number", "$value": 300 },
      "normal": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold": { "$type": "number", "$value": 700 },
      "extrabold": { "$type": "number", "$value": 800 }
    },
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": "Plus Jakarta Sans" },
      "mono": { "$type": "fontFamily", "$value": "Geist Mono" }
    },
    "borderRadius": {
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "8px" },
      "lg": { "$type": "dimension", "$value": "10px" },
      "xl": { "$type": "dimension", "$value": "14px" },
      "2xl": { "$type": "dimension", "$value": "16px" }
    },
    "borderWidth": {
      "default": { "$type": "dimension", "$value": "1px" },
      "2": { "$type": "dimension", "$value": "2px" }
    },
    "breakpoint": {
      "sm": { "$type": "dimension", "$value": "640px" },
      "md": { "$type": "dimension", "$value": "768px" },
      "lg": { "$type": "dimension", "$value": "1024px" },
      "xl": { "$type": "dimension", "$value": "1280px" }
    },
    "maxWidth": {
      "xl": { "$type": "dimension", "$value": "576px" },
      "2xl": { "$type": "dimension", "$value": "672px" },
      "7xl": { "$type": "dimension", "$value": "1280px" }
    },
    "height": {
      "8": { "$type": "dimension", "$value": "32px" },
      "9": { "$type": "dimension", "$value": "36px" },
      "10": { "$type": "dimension", "$value": "40px" }
    }
  },

  "semantic": {
    "$description": "Both themes always ship. $value holds the DEFAULT theme's color (dark in this template — set the default at intake); the other theme lives in $extensions.modes.light and is emitted as a `.light` class by scripts/build-tokens.mjs.",
    "color": {
      "background": { "$type": "color", "$value": "{primitive.color.black}", "$description": "Page background", "$extensions": { "modes": { "light": "{primitive.color.white}" } } },
      "foreground": { "$type": "color", "$value": "{primitive.color.neutral-50}", "$description": "Primary text", "$extensions": { "modes": { "light": "{primitive.color.neutral-900}" } } },
      "card": { "$type": "color", "$value": "{primitive.color.zinc-900}", "$description": "Card surface", "$extensions": { "modes": { "light": "{primitive.color.white}" } } },
      "card-foreground": { "$type": "color", "$value": "{primitive.color.neutral-50}", "$description": "Text on card", "$extensions": { "modes": { "light": "{primitive.color.neutral-900}" } } },
      "popover": { "$type": "color", "$value": "{primitive.color.zinc-900}", "$description": "Popover/dropdown surface", "$extensions": { "modes": { "light": "{primitive.color.white}" } } },
      "popover-foreground": { "$type": "color", "$value": "{primitive.color.neutral-50}", "$description": "Text on popover", "$extensions": { "modes": { "light": "{primitive.color.neutral-900}" } } },
      "primary": { "$type": "color", "$value": "{primitive.color.purple-500}", "$description": "Primary action / brand" },
      "primary-foreground": { "$type": "color", "$value": "{primitive.color.neutral-50}", "$description": "Text on primary" },
      "secondary": { "$type": "color", "$value": "{primitive.color.neutral-800}", "$description": "Secondary action", "$extensions": { "modes": { "light": "{primitive.color.neutral-100}" } } },
      "secondary-foreground": { "$type": "color", "$value": "{primitive.color.neutral-50}", "$description": "Text on secondary", "$extensions": { "modes": { "light": "{primitive.color.neutral-900}" } } },
      "accent": { "$type": "color", "$value": "#a29bfd66", "$description": "Accent highlight (translucent purple)" },
      "accent-foreground": { "$type": "color", "$value": "{primitive.color.neutral-50}", "$description": "Text on accent", "$extensions": { "modes": { "light": "{primitive.color.neutral-900}" } } },
      "muted": { "$type": "color", "$value": "{primitive.color.neutral-800}", "$description": "Muted background", "$extensions": { "modes": { "light": "{primitive.color.neutral-100}" } } },
      "muted-foreground": { "$type": "color", "$value": "{primitive.color.neutral-500}", "$description": "Muted/secondary text" },
      "border": { "$type": "color", "$value": "{primitive.color.neutral-800}", "$description": "Default border", "$extensions": { "modes": { "light": "{primitive.color.neutral-200}" } } },
      "input": { "$type": "color", "$value": "{primitive.color.neutral-800}", "$description": "Input border", "$extensions": { "modes": { "light": "{primitive.color.neutral-200}" } } },
      "ring": { "$type": "color", "$value": "{primitive.color.purple-accent}", "$description": "Focus ring" },
      "destructive": { "$type": "color", "$value": "{primitive.color.red-400}", "$description": "Destructive action" },
      "destructive-foreground": { "$type": "color", "$value": "{primitive.color.red-50}", "$description": "Text on destructive" },
      "sidebar-ring": { "$type": "color", "$value": "{primitive.color.purple-600}", "$description": "Sidebar focus ring" }
    },
    "shadow": {
      "xs": {
        "$type": "shadow",
        "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#0000000d" }
      }
    },
    "opacity": {
      "50": { "$type": "number", "$value": 0.5 },
      "60": { "$type": "number", "$value": 0.6 }
    }
  },

  "component": {
    "button": {
      "$description": "Button component tokens. Variants: Default, Secondary, Destructive, Outline, Ghost, Link. Sizes: sm(32px), default(36px), icon(36x36), lg(40px). States: Default, Hover, Focus, Pressed, Disabled, Loading.",
      "height-sm": { "$type": "dimension", "$value": "{primitive.height.8}" },
      "height-default": { "$type": "dimension", "$value": "{primitive.height.9}" },
      "height-lg": { "$type": "dimension", "$value": "{primitive.height.10}" },
      "bg-primary": { "$type": "color", "$value": "{semantic.color.primary}" },
      "bg-secondary": { "$type": "color", "$value": "{semantic.color.secondary}" },
      "bg-destructive-dark": { "$type": "color", "$value": "#f8717199" },
      "bg-destructive-dark-hover": { "$type": "color", "$value": "#f87171e5" },
      "focus-ring": { "$type": "color", "$value": "#a29bfd66" },
      "focus-ring-destructive": { "$type": "color", "$value": "#f8717166" }
    }
  }
}
